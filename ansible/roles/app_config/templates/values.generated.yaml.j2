{{ ansible_managed | comment }}
# Generated by ansible/roles/app_config for environment "{{ env_name }}".
# DO NOT EDIT — regenerate with: ansible-playbook ansible/site.yml -e env={{ env_name }}
#
# This file is the seam between the two tools: Ansible owns application
# configuration and writes it here; Helm consumes it as its final -f argument
# and owns the Kubernetes objects.

image:
  repository: {{ image_repository }}
  tag: "{{ image_tag }}"
  pullPolicy: {{ image_pull_policy }}

app:
  environment: {{ env_name }}
  logLevel: {{ app_log_level }}
  workers: {{ app_workers }}
  maxUploadBytes: {{ app_max_upload_bytes }}
  maxRowsDisplay: {{ app_max_rows_display }}
  maxFilesListed: {{ app_max_files_listed }}

s3:
  bucket: {{ s3_bucket }}
  prefix: {{ s3_prefix }}
  region: {{ s3_region }}
  endpointUrl: "{{ s3_endpoint_url }}"
  forcePathStyle: {{ s3_force_path_style | lower }}
  accessKeyId: "{{ s3_access_key_id }}"
  secretAccessKey: "{{ s3_secret_access_key }}"

minio:
  enabled: {{ minio_enabled | lower }}

# The nginx configuration rendered from nginx.conf.j2. The chart mounts this
# into the sidecar via its ConfigMap; a change here changes the ConfigMap
# checksum annotation, which rolls the pods.
nginx:
  config: |
{{ nginx_config | indent(4, true) }}
